# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
# NOTE: no '*~' rule — Unity package folders like Documentation~ end in a tilde.

# ---------------------------------------------------------------------------
# Unity — generated folders (present if this package is opened as a project
# or embedded under a test project's Packages/ folder)
# ---------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset store / package tooling
Assets/AssetStoreTools*
Assets/Plugins/Editor/JetBrains*
.vsconfig

# Unity crash / editor logs
sysinfo.txt
crashlytics-build.properties
*.stackdump

# ---------------------------------------------------------------------------
# Generated by Unity for IDEs (regenerated on import, never commit)
# ---------------------------------------------------------------------------
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE folders
.vs/
.idea/
.vscode/
.gradle/

# ---------------------------------------------------------------------------
# Build artifacts
# ---------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.ipa
*.xcarchive

# Addressables / build cache
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
ServerData/

# ---------------------------------------------------------------------------
# Node / docs tooling (if used for Documentation~)
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
.npmrc
